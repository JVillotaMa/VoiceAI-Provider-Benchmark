# Telephony (outbound calls from the Pipecat caller agent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Test endpoint: proves the caller agent can place a call and hold the conversation.
# The destination is configuration, never a request parameter — an authenticated endpoint that
# dials arbitrary numbers becomes a toll-fraud machine the moment its key leaks.
TEST_CALL_TO_NUMBER=
# Generate, do not choose:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TEST_CALL_API_KEY=
# Public URL Twilio must reach to open the media stream (e.g. an ngrok https URL). Changes on
# every tunnel restart.
PUBLIC_BASE_URL=

# Shared model/voice stack: identical across all platforms under test
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Platforms under test
VAPI_API_KEY=
RETELL_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Phone numbers of the agent under test, one per platform
VAPI_AGENT_NUMBER=
RETELL_AGENT_NUMBER=
ELEVENLABS_AGENT_NUMBER=
PIPECAT_AGENT_NUMBER=
LIVEKIT_AGENT_NUMBER=
